# ─────────────────────────────────────────────────────────────
# Environment configuration  —  THIS FILE IS PER-SITE.
# This repository publishes to: https://www.galapagosislands.travel
# Copy to ".env" and fill in. Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# --- WordPress REST API ---------------------------------------
# Your site URL (no trailing slash)
WP_BASE_URL=https://www.galapagosislands.travel

# WordPress user that owns the content (must have publish rights)
WP_USERNAME=

# Application Password (Users > Profile > Application Passwords in WP admin).
# Looks like: "abcd EFGH 1234 wxyz 5678 90ab" — spaces are OK.
WP_APP_PASSWORD=

# Default author ID to attribute posts to (optional; defaults to the API user)
# WP_DEFAULT_AUTHOR_ID=1

# --- Publishing behavior --------------------------------------
# draft | pending | publish   (default: draft — safest)
WP_DEFAULT_STATUS=draft

# --- Google Drive ingestion (optional) ------------------------
# Path to an OAuth client secret or service-account JSON file.
# See docs/SETUP.md for how to create this.
GDRIVE_CREDENTIALS_FILE=credentials.json
GDRIVE_TOKEN_FILE=token.json
# Restrict Drive ingestion to a single account (recommended). The system
# refuses any other account. Leave blank to allow any authorized account.
GDRIVE_ALLOWED_ACCOUNT=businessops@latintrails.com
